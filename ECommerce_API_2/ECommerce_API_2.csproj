<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>c60b697e-d768-4595-9764-d796f80d501e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
